{
  "uses": [
    {
      "plugin": "bitwarden.secrets",
      "paths": [
        "with-secrets.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "cloudflare.pages",
      "paths": [
        ".github/workflows/recipes.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "sonarcloud.scan",
      "paths": [
        ".github/workflows/main.yml",
        ".github/workflows/pr.yml"
      ],
      "mode": "required"
    }
  ],
  "own_hosts": [
    "schryer.eu",
    "sustenaut.eu"
  ],
  "other_secrets": [
    {
      "name": "RECIPES_DEPLOY_KEY",
      "reason": "An SSH key to our own server"
    }
  ]
}
